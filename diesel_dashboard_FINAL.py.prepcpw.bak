        self.inj_id_edit.setStyleSheet(
            f"background:{BORDER}; border:1px solid {BORDER2}; border-radius:5px;"
            f" padding:4px 8px; color:{TXT_PRI}; font-family:monospace; font-size:11px;")
        g.addWidget(self.inj_id_edit, 5, 1)
